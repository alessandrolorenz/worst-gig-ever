{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "importHelpers": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "module": "esnext",
    "paths": {
      "@entities": ["game/entities/index.ts"],
      "@svg": ["assets/SVG/index.ts"],
      "@systems": ["game/systems/index.ts"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
